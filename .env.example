# Скопируйте в .env (файл .env добавлен в .gitignore и не попадает в Git)
# Пароль хранится ТОЛЬКО в виде хеша PBKDF2-SHA256 (никогда в открытом виде)
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=pbkdf2_sha256$120000$replace_with_salt$replace_with_hash
ADMIN_SESSION_SECRET=replace_with_64_char_random_hex_secret
